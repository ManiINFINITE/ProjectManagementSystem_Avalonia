<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProjectManagementSystem.ViewModels"
             xmlns:models="clr-namespace:ProjectManagementSystem.Models"
             xmlns:converters="clr-namespace:ProjectManagementSystem.Converters"
             mc:Ignorable="d" d:DesignWidth="1366" d:DesignHeight="768"
             x:Class="ProjectManagementSystem.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel">
    
    <UserControl.Styles>
        <StyleInclude Source="../Styles/WelcomeStyles.axaml"/>
    </UserControl.Styles>
    
    <Border Classes="MainBorder">
        <Grid RowDefinitions="Auto, Auto, *, Auto, Auto">
            <TextBlock Classes="WelcomeText" Grid.Row="0" Text="Welcome to"/>
            <TextBlock Classes="AppName" Grid.Row="1" Text="Project Management System"/>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding RememberedUsers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   MaxWidth="1000"
                                   Margin="0 30 0 0"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:User">
                        <Border Classes="UserCard" Tapped="UserCard_Tapped" 
                                BorderBrush="{Binding AccentColorName, Converter={x:Static converters:AccentColorNameToBrushConverter.Instance}}">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Column="0" Classes="ImageBorder">
                                    <Panel>
                                        <Border CornerRadius="999"
                                                Background="{Binding Converter={x:Static converters:UserAvatarColorConverter.Instance}}"
                                                IsVisible="{Binding ProfilePicture, Converter={x:Static ObjectConverters.IsNull}}">
                                            <TextBlock Text="{Binding Initials}"
                                                       FontFamily="{DynamicResource Nunito-Bold}"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="25"/>
                                        </Border>
                                        <Image Source="{Binding ProfilePicture?.PictureData, Converter={x:Static converters:ByteArrayToBitmapConverter.Instance}}"
                                               IsVisible="{Binding ProfilePicture, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </Panel>
                                </Border>
                                <Grid Grid.Column="1" RowDefinitions="Auto, Auto" Margin="10 0 0 0">
                                    <TextBlock Classes="UsernameText" Grid.Row="0" Text="{Binding Username}"/>
                                    <TextBlock Classes="FullnameText" Grid.Row="1" Text="{Binding FullName}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Border Classes="Ellipse" Grid.Column="2">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%, 100%" EndPoint="50%, 0%">
                                            <GradientStop Offset="0"
                                                          Color="{Binding AccentColorName, Converter={x:Static converters:AccentColorNameToPrimaryConverter.Instance}}"/>
                                            <GradientStop Offset="1"
                                                          Color="{Binding AccentColorName, Converter={x:Static converters:AccentColorNameToSecondaryConverter.Instance}}"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Grid.Row="3" ColumnDefinitions="*, Auto, *" Margin="0 20 0 20">
                <Border Classes="SideLines" Grid.Column="0"
                        Margin="250 0 0 0"
                        Opacity="0.5"/>
                <TextBlock Classes="OrText" Grid.Column="1" Text="or"
                           Margin="20 0"
                           Opacity="0.5"/>
                <Border Classes="SideLines" Grid.Column="2"
                        Margin="0 0 250 0"
                        Opacity="0.5"/>
            </Grid>
            <Button Grid.Row="4"
                    Command="{Binding SignInWithDifferentAccountCommand}"
                    Classes="UseAnotherAccountButton">
                <TextBlock Text="Use Another Account"/>
            </Button>
        </Grid>
    </Border>
    
</UserControl>
