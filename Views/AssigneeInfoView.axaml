<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProjectManagementSystem.ViewModels"
             xmlns:models="clr-namespace:ProjectManagementSystem.Models"
             xmlns:converters="clr-namespace:ProjectManagementSystem.Converters"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
             x:Class="ProjectManagementSystem.Views.AssigneeInfoView"
             x:DataType="vm:ProjectCreationViewModel">
    
    <UserControl.Styles>
        <StyleInclude Source="../Styles/ProjectCreationStyles.axaml"/>
    </UserControl.Styles>
    
    <Border Classes="MainBorder" ClipToBounds="False">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" ClipToBounds="False">
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0 5 0 5">
                <TextBlock Classes="HeaderIcon" Grid.Column="0" Text="&#xE4D6;"/>
                <TextBlock Classes="HeaderText" Grid.Column="1" Text="Assignees Info"/>
            </Grid>
            <!-- search for user -->
            <Grid Classes="ItemGrid" Grid.Row="1" RowDefinitions="Auto, Auto" ClipToBounds="False">
                <TextBlock Grid.Row="0" Classes="ProjectLabel" Text="Search For User To Assign"/>
                <AutoCompleteBox x:Name="UserSearchBox"
                                 Grid.Row="1"
                                 Classes="UserSearchBox"
                                 PlaceholderText="Search by Name or Username ..."
                                 ItemsSource="{Binding AllUsers}"
                                 FilterMode="Contains"
                                 SelectedItem="{Binding SelectedUser}"
                                 ValueMemberBinding="{Binding FullNameUsername, x:DataType=models:User}"/>
                
            </Grid>
            <!-- Role -->
            <Grid Classes="ItemGrid" Grid.Row="2" RowDefinitions="Auto, Auto">
                <TextBlock Grid.Row="0" Classes="ProjectLabel" Text="Assignee Role"/>
                <TextBox Grid.Row="1" Classes="ProjectTextBox" PlaceholderText="Role" Text="{Binding AssigneeRole}"/>
            </Grid>
            <!-- Add Button -->
            <Button Grid.Row="3" Classes="AssignUserButton" Command="{Binding AssignUserCommand}">
                <Grid ColumnDefinitions="*, *">
                    <TextBlock Grid.Column="0" Classes="AssignIcon" Text="&#xE4D0;"/>
                    <TextBlock Grid.Column="1" Classes="AssignText" Text="Assign User"/>
                </Grid>
            </Button>
            <!-- users list header -->
            <Border Grid.Row="4" Classes="Divider"></Border>
            <!-- assignees list -->
            <ScrollViewer Grid.Row="5" MaxHeight="325" VerticalScrollBarVisibility="Auto" Margin="-8 5">
                <ItemsControl ItemsSource="{Binding Assignees}" ClipToBounds="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:AssigneeEntry">
                            <Border Classes="AssigneeCard">
                                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                    <Border Classes="AssigneePicBorder" Grid.Column="0">
                                        <Panel>
                                            <Border CornerRadius="999"
                                                    Background="{Binding User, Converter={x:Static converters:UserAvatarColorConverter.Instance}}"
                                                    IsVisible="{Binding User.ProfilePicture, Converter={x:Static ObjectConverters.IsNull}}">
                                                <TextBlock Text="{Binding User.Initials}"
                                                           FontFamily="{DynamicResource Nunito-Bold}"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding User.ProfilePicture, Converter={x:Static converters:ByteArrayToBitmapConverter.Instance}}"
                                                   IsVisible="{Binding User.ProfilePicture, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        </Panel>
                                    </Border>
                                    <Grid Grid.Column="1" RowDefinitions="Auto, Auto">
                                        <TextBlock Classes="AssigneeName" Grid.Row="0"
                                                   Text="{Binding User.FullName, Converter={x:Static converters:LongStringConverter.Instance}, ConverterParameter=20}"
                                                   ToolTip.Tip="{Binding User.FullName}"/>
                                        <TextBlock Classes="AssigneeEmail" Grid.Row="1"
                                                   Text="{Binding User.Email, Converter={x:Static converters:LongStringConverter.Instance}, ConverterParameter=23}"
                                                   ToolTip.Tip="{Binding User.Email}"/>
                                    </Grid>
                                    <Border Classes="AssigneeRoleBorder" Grid.Column="2"
                                            Background="{Binding Role, Converter={x:Static converters:RoleBackgroundColorConverter.Instance}}">
                                        <TextBlock Text="{Binding Role, Converter={x:Static converters:LongStringConverter.Instance}, ConverterParameter=17}"
                                                   ToolTip.Tip="{Binding Role}"
                                                   Foreground="{Binding Role, Converter={x:Static converters:RoleTextColorConverter.Instance}}"/>
                                    </Border>
                                    <Button Classes="RemoveAssigneeButton" Grid.Column="3"
                                            Command="{Binding $parent[ItemsControl].((vm:ProjectCreationViewModel)DataContext)?.RemoveAssigneeCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE4F6;"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
    
</UserControl>
