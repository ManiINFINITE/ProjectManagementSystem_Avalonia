<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:ProjectManagementSystem.Views"
             xmlns:vm="clr-namespace:ProjectManagementSystem.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="1000"
             x:Class="ProjectManagementSystem.Views.ProjectCreationView"
             x:DataType="vm:ProjectCreationViewModel">
    
    <UserControl.Styles>
        <StyleInclude Source="../Styles/ProjectCreationStyles.axaml"/>
    </UserControl.Styles>
    
    <Border CornerRadius="15" ClipToBounds="True" Background="{DynamicResource ElementGeneralBackground}">
        <Grid RowDefinitions="Auto, Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*, *, *" Width="1300" Height="700">
                <Border Grid.Column="0" Padding="5" Margin="0 5" ClipToBounds="False">
                    <views:ProjectInfoView/>
                </Border>
                <Border Grid.Column="1" Padding="5" Margin="0 5" ClipToBounds="False">
                    <views:AssigneeInfoView/>
                </Border>
                <Border Grid.Column="2" Padding="5" Margin="0 5" ClipToBounds="False">
                    <views:TaskInfoView/>
                </Border>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
                <Button Classes="CancelProjectButton" Grid.Column="0" Content="Cancel" Command="{Binding DiscardCommand}"/>
                <Button Classes="CreateProjectButton" Grid.Column="1" Command="{Binding CreateProjectCommand}">
                    <Grid ColumnDefinitions="*, *">
                        <TextBlock Classes="Icon" Grid.Column="0" Text="&#xE258;"/>
                        <TextBlock Classes="Text" Grid.Column="1" Text="Create Project"/>
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </Border>
    
</UserControl>